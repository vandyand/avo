ARG SOURCE_DATE_EPOCH=0
FROM python:3.12.10-slim-bookworm@sha256:97983fa8cc88343512862c62307159a82261c3528dc025f79e5a3f7af43e50b4 AS materials

COPY evaluators/reference/entrypoint.py /source/entrypoint.py
COPY evaluators/reference/admission/tests.json /source/tests.json
RUN mkdir -p /rootfs/app /rootfs/evaluator \
    && cp /source/entrypoint.py /rootfs/app/entrypoint.py \
    && cp /source/tests.json /rootfs/evaluator/tests.json \
    && chmod 0755 /rootfs /rootfs/app /rootfs/evaluator \
    && chmod 0644 /rootfs/app/entrypoint.py /rootfs/evaluator/tests.json \
    && find /rootfs -exec touch --date=@0 {} +

FROM python:3.12.10-slim-bookworm@sha256:97983fa8cc88343512862c62307159a82261c3528dc025f79e5a3f7af43e50b4

COPY --from=materials --chown=65534:65534 /rootfs/ /

USER 65534:65534
ENTRYPOINT ["python", "/app/entrypoint.py"]
