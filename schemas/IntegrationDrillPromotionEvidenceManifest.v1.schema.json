{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size_bytes",
        "media_type",
        "role",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "IntegrationDrillPromotionEvidenceLink": {
      "additionalProperties": false,
      "description": "A typed link to one durable child promotion record.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "kind": {
          "enum": [
            "intent",
            "lease_evidence",
            "mutation_authorization",
            "receipt"
          ],
          "title": "Kind",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Operation Id",
          "type": "string"
        },
        "record_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Record Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "operation_id",
        "record_digest",
        "artifact"
      ],
      "title": "IntegrationDrillPromotionEvidenceLink",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Root-journal manifest for reconstructing case-7 promotion evidence.",
  "properties": {
    "failed_integration_head_commit": {
      "title": "Failed Integration Head Commit",
      "type": "string"
    },
    "failed_integration_head_tree": {
      "title": "Failed Integration Head Tree",
      "type": "string"
    },
    "links": {
      "items": {
        "$ref": "#/$defs/IntegrationDrillPromotionEvidenceLink"
      },
      "maxItems": 4,
      "minItems": 4,
      "title": "Links",
      "type": "array"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "promotion_operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Promotion Operation Id",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "restore_to_tree": {
      "title": "Restore To Tree",
      "type": "string"
    },
    "result_commit": {
      "title": "Result Commit",
      "type": "string"
    },
    "result_tree": {
      "title": "Result Tree",
      "type": "string"
    },
    "rollback_candidate_commit": {
      "title": "Rollback Candidate Commit",
      "type": "string"
    },
    "rollback_candidate_parent_commit": {
      "title": "Rollback Candidate Parent Commit",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_ref": {
      "minLength": 1,
      "title": "Target Ref",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "promotion_operation_id",
    "repository_digest",
    "target_ref",
    "failed_integration_head_commit",
    "failed_integration_head_tree",
    "restore_to_tree",
    "rollback_candidate_commit",
    "rollback_candidate_parent_commit",
    "result_commit",
    "result_tree",
    "links",
    "manifest_digest"
  ],
  "title": "IntegrationDrillPromotionEvidenceManifest",
  "type": "object"
}
