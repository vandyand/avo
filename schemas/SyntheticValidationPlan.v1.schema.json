{
  "$defs": {
    "SyntheticValidationObservation": {
      "additionalProperties": false,
      "description": "The exact current PR and synthetic merge observation being validated.",
      "properties": {
        "base_commit": {
          "title": "Base Commit",
          "type": "string"
        },
        "base_ref": {
          "minLength": 1,
          "title": "Base Ref",
          "type": "string"
        },
        "base_tree": {
          "title": "Base Tree",
          "type": "string"
        },
        "head_commit": {
          "title": "Head Commit",
          "type": "string"
        },
        "head_ref": {
          "minLength": 1,
          "title": "Head Ref",
          "type": "string"
        },
        "head_tree": {
          "title": "Head Tree",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "synthetic_commit": {
          "title": "Synthetic Commit",
          "type": "string"
        },
        "synthetic_tree": {
          "title": "Synthetic Tree",
          "type": "string"
        }
      },
      "required": [
        "repository_digest",
        "base_ref",
        "base_commit",
        "base_tree",
        "head_ref",
        "head_commit",
        "head_tree",
        "synthetic_commit",
        "synthetic_tree"
      ],
      "title": "SyntheticValidationObservation",
      "type": "object"
    },
    "SyntheticValidationRequest": {
      "additionalProperties": false,
      "description": "Immutable request including target identity and trusted check contexts.",
      "properties": {
        "observation": {
          "$ref": "#/$defs/SyntheticValidationObservation"
        },
        "provider_api_version": {
          "default": "1",
          "minLength": 1,
          "title": "Provider Api Version",
          "type": "string"
        },
        "provider_identity": {
          "default": "synthetic-validation-provider",
          "minLength": 1,
          "title": "Provider Identity",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_identity": {
          "minLength": 1,
          "title": "Target Identity",
          "type": "string"
        },
        "target_ref": {
          "minLength": 1,
          "title": "Target Ref",
          "type": "string"
        },
        "target_repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Repository Digest",
          "type": "string"
        },
        "trusted_check_contexts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Trusted Check Contexts",
          "type": "array"
        }
      },
      "required": [
        "observation",
        "target_repository_digest",
        "target_ref",
        "target_identity",
        "trusted_check_contexts"
      ],
      "title": "SyntheticValidationRequest",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Durable immutable intent written before touching the remote ref.",
  "properties": {
    "expected_commit": {
      "title": "Expected Commit",
      "type": "string"
    },
    "expected_tree": {
      "title": "Expected Tree",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/SyntheticValidationRequest"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "validation_ref": {
      "minLength": 1,
      "title": "Validation Ref",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "request",
    "validation_ref",
    "expected_commit",
    "expected_tree"
  ],
  "title": "SyntheticValidationPlan",
  "type": "object"
}
