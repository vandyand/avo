{
  "$defs": {
    "MainCheckObservation": {
      "additionalProperties": false,
      "properties": {
        "app_id": {
          "exclusiveMinimum": 0,
          "title": "App Id",
          "type": "integer"
        },
        "conclusion": {
          "enum": [
            "success",
            "neutral",
            "failure",
            "pending"
          ],
          "title": "Conclusion",
          "type": "string"
        },
        "context": {
          "minLength": 1,
          "title": "Context",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "nonce": {
          "minLength": 1,
          "title": "Nonce",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "run_id": {
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "sha": {
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
          "title": "Sha",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "in_progress",
            "queued"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "context",
        "app_id",
        "sha",
        "status",
        "conclusion",
        "run_id",
        "nonce",
        "observed_at"
      ],
      "title": "MainCheckObservation",
      "type": "object"
    },
    "MainMergeGroupChecks": {
      "additionalProperties": false,
      "properties": {
        "allowlisted_contexts": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Allowlisted Contexts",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/MainCheckObservation"
          },
          "minItems": 1,
          "title": "Checks",
          "type": "array"
        },
        "composition_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Composition Digest",
          "type": "string"
        },
        "config_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Config Digest",
          "type": "string"
        },
        "freshness_cutoff": {
          "format": "date-time",
          "title": "Freshness Cutoff",
          "type": "string"
        },
        "group_sha": {
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
          "title": "Group Sha",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Operation Id",
          "type": "string"
        },
        "package_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Package Digest",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_ref": {
          "const": "refs/heads/main",
          "default": "refs/heads/main",
          "title": "Target Ref",
          "type": "string"
        },
        "validation_app_id": {
          "const": 15368,
          "default": 15368,
          "title": "Validation App Id",
          "type": "integer"
        }
      },
      "required": [
        "repository_digest",
        "operation_id",
        "package_digest",
        "composition_digest",
        "group_sha",
        "checks",
        "allowlisted_contexts",
        "config_digest",
        "freshness_cutoff",
        "observed_at"
      ],
      "title": "MainMergeGroupChecks",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Distinct pending group-specific hold, created after queue admission.",
  "properties": {
    "admission_observation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Admission Observation Digest",
      "type": "string"
    },
    "attestation_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Attestation Manifest Digest",
      "type": "string"
    },
    "base_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Base Commit",
      "type": "string"
    },
    "base_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Base Tree",
      "type": "string"
    },
    "check_conclusion": {
      "const": "pending",
      "default": "pending",
      "title": "Check Conclusion",
      "type": "string"
    },
    "check_context": {
      "const": "avo-main-release",
      "default": "avo-main-release",
      "title": "Check Context",
      "type": "string"
    },
    "check_state": {
      "const": "in_progress",
      "default": "in_progress",
      "title": "Check State",
      "type": "string"
    },
    "composition_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Composition Digest",
      "type": "string"
    },
    "composition_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Composition Tree",
      "type": "string"
    },
    "expected_group_parents": {
      "items": {
        "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Expected Group Parents",
      "type": "array"
    },
    "group_parents": {
      "items": {
        "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Group Parents",
      "type": "array"
    },
    "group_sha": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Group Sha",
      "type": "string"
    },
    "group_topology_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Group Topology Digest",
      "type": "string"
    },
    "group_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Group Tree",
      "type": "string"
    },
    "hold_nonce": {
      "minLength": 1,
      "title": "Hold Nonce",
      "type": "string"
    },
    "hold_run_id": {
      "minLength": 1,
      "title": "Hold Run Id",
      "type": "string"
    },
    "issuer_identity": {
      "minLength": 1,
      "title": "Issuer Identity",
      "type": "string"
    },
    "issuer_isolation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Issuer Isolation Digest",
      "type": "string"
    },
    "max_entries_per_group": {
      "const": 1,
      "default": 1,
      "title": "Max Entries Per Group",
      "type": "integer"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "other_required_checks": {
      "$ref": "#/$defs/MainMergeGroupChecks"
    },
    "package_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Package Digest",
      "type": "string"
    },
    "preparation_authorization_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Preparation Authorization Digest",
      "type": "string"
    },
    "protection_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Protection Manifest Digest",
      "type": "string"
    },
    "pull_request_number": {
      "exclusiveMinimum": 0,
      "title": "Pull Request Number",
      "type": "integer"
    },
    "queue_generation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Queue Generation Digest",
      "type": "string"
    },
    "queue_members": {
      "items": {
        "type": "integer"
      },
      "maxItems": 1,
      "minItems": 1,
      "title": "Queue Members",
      "type": "array"
    },
    "release_issuer_app_id": {
      "exclusiveMinimum": 0,
      "title": "Release Issuer App Id",
      "type": "integer"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    },
    "validation_app_id": {
      "const": 15368,
      "default": 15368,
      "title": "Validation App Id",
      "type": "integer"
    }
  },
  "required": [
    "repository_digest",
    "operation_id",
    "preparation_authorization_digest",
    "admission_observation_digest",
    "package_digest",
    "composition_digest",
    "pull_request_number",
    "group_sha",
    "group_tree",
    "group_parents",
    "expected_group_parents",
    "group_topology_digest",
    "base_commit",
    "base_tree",
    "composition_tree",
    "queue_generation_digest",
    "queue_members",
    "hold_run_id",
    "hold_nonce",
    "issuer_identity",
    "release_issuer_app_id",
    "issuer_isolation_digest",
    "other_required_checks",
    "protection_manifest_digest",
    "attestation_manifest_digest",
    "observed_at"
  ],
  "title": "MainReleaseHoldObservation",
  "type": "object"
}
