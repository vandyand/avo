        "delta_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Delta Digest",
          "type": "string"
        },
        "deploy_performed": {
          "const": false,
          "default": false,
          "title": "Deploy Performed",
          "type": "boolean"
        },
        "operation_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Operation Id",
          "type": "string"
        },
        "ordinary_risk": {
          "const": "ordinary",
