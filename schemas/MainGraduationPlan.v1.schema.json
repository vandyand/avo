        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_result_commit": {
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
          "title": "Source Result Commit",
          "type": "string"
        },
        "source_result_parent": {
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
          "title": "Source Result Parent",
          "type": "string"
        },
        "source_result_tree": {
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
          "title": "Source Result Tree",
          "type": "string"
        },
        "target_ref": {
          "const": "refs/heads/main",
          "default": "refs/heads/main",
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "repository_digest",
        "operation_id",
        "package_digest",
        "source_result_commit",
        "source_result_parent",
        "source_result_tree",
        "changed_paths",
        "path_manifest_digest",
        "delta_digest",
        "ordinary_risk_digest"
      ],
      "title": "MainDeltaManifest",
      "type": "object"
    },
    "MainReleaseIssuerBinding": {
      "additionalProperties": false,
      "description": "Immutable controller root for release and integration-package authority.",
