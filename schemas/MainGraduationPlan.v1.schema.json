            "$ref": "#/$defs/ArtifactRef"
          },
          "minItems": 1,
          "title": "Child Artifacts",
          "type": "array"
        },
        "completion_state": {
          "const": "successful",
          "default": "successful",
          "title": "Completion State",
          "type": "string"
        },
        "deploy_performed": {
          "const": false,
          "default": false,
          "title": "Deploy Performed",
          "type": "boolean"
        },
        "operation_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Operation Id",
          "type": "string"
        },
        "package_artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "package_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Package Digest",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_domain": {
          "const": "integration-campaign",
          "default": "integration-campaign",
          "title": "Source Domain",
          "type": "string"
        },
        "source_issuer": {
          "minLength": 1,
          "title": "Source Issuer",
          "type": "string"
        },
        "source_operation_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Operation Id",
          "type": "string"
        },
        "source_result_commit": {
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
