{
  "additionalProperties": false,
  "description": "Typed inverse of a completed main result; opaque rollback digests are forbidden.",
  "properties": {
    "completion_package_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Completion Package Digest",
      "type": "string"
    },
    "current_main_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Current Main Commit",
      "type": "string"
    },
    "current_main_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Current Main Tree",
      "type": "string"
    },
    "deploy_performed": {
      "const": false,
      "default": false,
      "title": "Deploy Performed",
      "type": "boolean"
    },
    "inverse_changed_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Inverse Changed Paths",
      "type": "array"
    },
    "inverse_delta_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Inverse Delta Digest",
      "type": "string"
    },
    "inverse_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Inverse Tree",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "policy_epoch": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Epoch",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    }
  },
  "required": [
    "repository_digest",
    "operation_id",
    "completion_package_digest",
    "current_main_commit",
    "current_main_tree",
    "inverse_changed_paths",
    "inverse_tree",
    "policy_epoch",
    "inverse_delta_digest"
  ],
  "title": "MainInverseDeltaArtifact",
  "type": "object"
}
