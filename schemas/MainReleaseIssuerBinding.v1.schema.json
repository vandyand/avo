{
  "additionalProperties": false,
  "description": "Immutable controller root for release and integration-package authority.",
  "properties": {
    "app_id": {
      "exclusiveMinimum": 0,
      "title": "App Id",
      "type": "integer"
    },
    "binding_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Binding Digest",
      "type": "string"
    },
    "controller_config_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Controller Config Digest",
      "type": "string"
    },
    "isolation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Isolation Digest",
      "type": "string"
    },
    "issuer_domain": {
      "const": "isolated-release-check",
      "default": "isolated-release-check",
      "title": "Issuer Domain",
      "type": "string"
    },
    "issuer_id": {
      "minLength": 1,
      "title": "Issuer Id",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    },
    "trusted_source_domain": {
      "const": "integration-campaign",
      "default": "integration-campaign",
      "title": "Trusted Source Domain",
      "type": "string"
    },
    "trusted_source_issuer": {
      "minLength": 1,
      "title": "Trusted Source Issuer",
      "type": "string"
    }
  },
  "required": [
    "repository_digest",
    "operation_id",
    "controller_config_digest",
    "issuer_id",
    "app_id",
    "isolation_digest",
    "trusted_source_issuer",
    "binding_digest"
  ],
  "title": "MainReleaseIssuerBinding",
  "type": "object"
}
