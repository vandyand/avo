      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "preparation": {
      "$ref": "#/$defs/CampaignPreparationEvidence"
    },
    "publication": {
      "$ref": "#/$defs/CandidatePublicationBinding"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
