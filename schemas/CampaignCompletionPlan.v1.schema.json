{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size_bytes",
        "media_type",
        "role",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CampaignDiscoveryEvidence": {
      "additionalProperties": false,
      "description": "Durable provider discovery captured before the promotion attempt.",
      "properties": {
        "main_before_commit": {
          "title": "Main Before Commit",
          "type": "string"
        },
        "observation": {
          "$ref": "#/$defs/IntegrationProviderObservation"
        },
        "open_identity": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Open Identity",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "observation",
        "main_before_commit",
        "open_identity"
      ],
      "title": "CampaignDiscoveryEvidence",
      "type": "object"
    },
    "CampaignOpenedEvidence": {
      "additionalProperties": false,
      "description": "Durable, provider-returned identity for the opened campaign PR.",
      "properties": {
        "base_commit": {
          "title": "Base Commit",
          "type": "string"
        },
        "base_tree": {
          "title": "Base Tree",
          "type": "string"
        },
        "open_identity": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Open Identity",
          "type": "string"
        },
        "pull_request_number": {
          "exclusiveMinimum": 0,
          "title": "Pull Request Number",
          "type": "integer"
        },
        "pull_request_url": {
          "minLength": 1,
          "title": "Pull Request Url",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "target_ref": {
          "minLength": 1,
          "title": "Target Ref",
          "type": "string"
        }
      },
      "required": [
        "pull_request_number",
        "pull_request_url",
        "target_ref",
        "base_commit",
        "base_tree",
        "open_identity"
      ],
      "title": "CampaignOpenedEvidence",
      "type": "object"
    },
    "CampaignPreparationEvidence": {
      "additionalProperties": false,
      "description": "Durable marker/template binding immediately before promotion.",
      "properties": {
        "marker_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker Digest"
        },
        "marker_verified": {
          "title": "Marker Verified",
          "type": "boolean"
        },
        "observation": {
          "$ref": "#/$defs/IntegrationProviderObservation"
        },
        "open_identity": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Open Identity",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "template": {
          "$ref": "#/$defs/IntegrationIntentTemplate"
        }
      },
      "required": [
        "template",
        "observation",
        "marker_verified",
        "open_identity"
      ],
      "title": "CampaignPreparationEvidence",
      "type": "object"
    },
    "CandidatePublicationBinding": {
      "additionalProperties": false,
      "description": "Trusted proof that the candidate was published from the evaluated source.\n\nA PR observation is not sufficient provenance: the provider could be showing a\ndifferent head than the controller evaluated.  This record is produced by the\ncontroller's trusted publication path and is independently verified before any\nprovider mutation is allowed.",
      "properties": {
        "base_commit": {
          "title": "Base Commit",
          "type": "string"
        },
        "base_tree": {
          "title": "Base Tree",
          "type": "string"
        },
        "candidate_commit": {
          "title": "Candidate Commit",
          "type": "string"
        },
        "candidate_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Digest",
          "type": "string"
        },
        "candidate_ref": {
          "minLength": 1,
          "title": "Candidate Ref",
          "type": "string"
        },
        "candidate_tree": {
          "title": "Candidate Tree",
          "type": "string"
        },
        "changed_paths": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Changed Paths",
          "type": "array"
        },
        "controller_publisher_identity": {
          "minLength": 1,
          "title": "Controller Publisher Identity",
          "type": "string"
        },
        "publication_evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Publication Evidence Digest",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "verified": {
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "repository_digest",
        "base_commit",
        "base_tree",
        "candidate_digest",
        "candidate_ref",
        "candidate_commit",
        "candidate_tree",
        "controller_publisher_identity",
        "publication_evidence_digest",
        "verified"
      ],
      "title": "CandidatePublicationBinding",
      "type": "object"
    },
    "GateAttestation": {
      "additionalProperties": false,
      "properties": {
        "base_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Base Digest",
          "type": "string"
        },
        "candidate_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Digest",
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "gate_name": {
          "minLength": 1,
          "title": "Gate Name",
          "type": "string"
        },
        "issuer_id": {
          "minLength": 1,
          "title": "Issuer Id",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "valid_from_epoch": {
          "minimum": 0,
          "title": "Valid From Epoch",
          "type": "integer"
        },
        "valid_until_epoch": {
          "minimum": 0,
          "title": "Valid Until Epoch",
          "type": "integer"
        }
      },
      "required": [
        "gate_name",
        "candidate_digest",
        "base_digest",
        "evidence_digest",
        "issuer_id",
        "passed",
        "valid_from_epoch",
        "valid_until_epoch"
      ],
      "title": "GateAttestation",
      "type": "object"
    },
    "GitRefSnapshot": {
      "additionalProperties": false,
      "description": "The trusted Git state against which a dry-run was evaluated.",
      "properties": {
        "commit": {
          "title": "Commit",
          "type": "string"
        },
        "protection_evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Protection Evidence Digest",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "source_tree_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Source Tree Digest",
          "type": "string"
        },
        "target_ref": {
          "minLength": 1,
          "title": "Target Ref",
          "type": "string"
        },
        "tree": {
          "title": "Tree",
          "type": "string"
        }
      },
      "required": [
        "repository_digest",
        "target_ref",
        "commit",
        "tree",
        "source_tree_digest",
        "protection_evidence_digest"
      ],
      "title": "GitRefSnapshot",
      "type": "object"
    },
    "IntegrationIntentTemplate": {
      "additionalProperties": false,
      "description": "Lease-independent promotion identity awaiting a fresh controller lease.",
      "properties": {
        "base_commit": {
          "title": "Base Commit",
          "type": "string"
        },
        "base_tree": {
          "title": "Base Tree",
          "type": "string"
        },
        "bundle_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Bundle Digest",
          "type": "string"
        },
        "candidate_commit": {
          "title": "Candidate Commit",
          "type": "string"
        },
        "candidate_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Digest",
          "type": "string"
        },
        "candidate_head_commit": {
          "title": "Candidate Head Commit",
          "type": "string"
        },
        "candidate_head_ref": {
          "minLength": 1,
          "title": "Candidate Head Ref",
          "type": "string"
        },
        "candidate_head_tree": {
          "title": "Candidate Head Tree",
          "type": "string"
        },
        "candidate_ref": {
          "minLength": 1,
          "title": "Candidate Ref",
          "type": "string"
        },
        "candidate_repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Repository Digest",
          "type": "string"
        },
        "candidate_tree": {
          "title": "Candidate Tree",
          "type": "string"
        },
        "check_evidence_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Check Evidence Manifest Digest",
          "type": "string"
        },
        "controller_config_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Controller Config Digest",
          "type": "string"
        },
        "evidence_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Manifest Digest",
          "type": "string"
        },
        "expected_main_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Main Commit"
        },
        "merge_method": {
          "const": "squash",
          "title": "Merge Method",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Operation Id",
          "type": "string"
        },
        "protection_evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Protection Evidence Digest",
          "type": "string"
        },
        "provider_api_version": {
          "minLength": 1,
          "title": "Provider Api Version",
          "type": "string"
        },
        "provider_identity": {
          "minLength": 1,
          "title": "Provider Identity",
          "type": "string"
        },
        "publication_evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Publication Evidence Digest",
          "type": "string"
        },
        "pull_request_number": {
          "exclusiveMinimum": 0,
          "title": "Pull Request Number",
          "type": "integer"
        },
        "pull_request_url": {
          "minLength": 1,
          "title": "Pull Request Url",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "synthetic_merge_commit": {
          "title": "Synthetic Merge Commit",
          "type": "string"
        },
        "synthetic_merge_tree": {
          "title": "Synthetic Merge Tree",
          "type": "string"
        },
        "target_base_commit": {
          "title": "Target Base Commit",
          "type": "string"
        },
        "target_base_ref": {
          "minLength": 1,
          "title": "Target Base Ref",
          "type": "string"
        },
        "target_base_tree": {
          "title": "Target Base Tree",
          "type": "string"
        },
        "target_ref": {
          "minLength": 1,
          "title": "Target Ref",
          "type": "string"
        },
        "target_repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Repository Digest",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "repository_digest",
        "candidate_ref",
        "target_ref",
        "base_commit",
        "base_tree",
        "candidate_commit",
        "candidate_tree",
        "candidate_repository_digest",
        "candidate_head_ref",
        "candidate_head_commit",
        "candidate_head_tree",
        "target_repository_digest",
        "target_base_ref",
        "target_base_commit",
        "target_base_tree",
        "synthetic_merge_commit",
        "synthetic_merge_tree",
        "bundle_digest",
        "candidate_digest",
        "controller_config_digest",
        "protection_evidence_digest",
        "evidence_manifest_digest",
        "check_evidence_manifest_digest",
        "publication_evidence_digest",
        "pull_request_number",
        "pull_request_url",
        "provider_identity",
        "provider_api_version",
        "merge_method"
      ],
      "title": "IntegrationIntentTemplate",
      "type": "object"
    },
    "IntegrationProviderObservation": {
      "additionalProperties": false,
      "description": "Provider-side PR observation used before requesting a merge.",
      "properties": {
        "base_commit": {
          "title": "Base Commit",
          "type": "string"
        },
        "base_ref": {
          "minLength": 1,
          "title": "Base Ref",
          "type": "string"
        },
        "base_tree": {
          "title": "Base Tree",
          "type": "string"
        },
        "candidate_repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Repository Digest",
          "type": "string"
        },
        "candidate_tree": {
          "title": "Candidate Tree",
          "type": "string"
        },
        "check_evidence_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Check Evidence Manifest Digest",
          "type": "string"
        },
        "draft": {
          "const": false,
          "default": false,
          "title": "Draft",
          "type": "boolean"
        },
        "head_commit": {
          "title": "Head Commit",
          "type": "string"
        },
        "head_ref": {
          "minLength": 1,
          "title": "Head Ref",
          "type": "string"
        },
        "open_state": {
          "const": "open",
          "title": "Open State",
          "type": "string"
        },
        "protection_evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Protection Evidence Digest",
          "type": "string"
        },
        "provider_api_version": {
          "minLength": 1,
          "title": "Provider Api Version",
          "type": "string"
        },
        "provider_identity": {
          "minLength": 1,
          "title": "Provider Identity",
          "type": "string"
        },
        "pull_request_number": {
          "exclusiveMinimum": 0,
          "title": "Pull Request Number",
          "type": "integer"
        },
        "pull_request_url": {
          "minLength": 1,
          "title": "Pull Request Url",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "synthetic_merge_commit": {
          "title": "Synthetic Merge Commit",
          "type": "string"
        },
        "synthetic_merge_tree": {
          "title": "Synthetic Merge Tree",
          "type": "string"
        },
        "target_repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Repository Digest",
          "type": "string"
        }
      },
      "required": [
        "repository_digest",
        "pull_request_number",
        "pull_request_url",
        "candidate_repository_digest",
        "target_repository_digest",
        "base_ref",
        "base_commit",
        "base_tree",
        "head_ref",
        "head_commit",
        "candidate_tree",
        "synthetic_merge_commit",
        "synthetic_merge_tree",
        "protection_evidence_digest",
        "check_evidence_manifest_digest",
        "provider_identity",
        "provider_api_version",
        "open_state"
      ],
      "title": "IntegrationProviderObservation",
      "type": "object"
    },
    "PathManifestAttestation": {
      "additionalProperties": false,
      "properties": {
        "base_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Base Digest",
          "type": "string"
        },
        "candidate_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Digest",
          "type": "string"
        },
        "evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Digest",
          "type": "string"
        },
        "issuer_id": {
          "minLength": 1,
          "title": "Issuer Id",
          "type": "string"
        },
        "path_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Path Manifest Digest",
          "type": "string"
        },
        "valid_from_epoch": {
          "minimum": 0,
          "title": "Valid From Epoch",
          "type": "integer"
        },
        "valid_until_epoch": {
          "minimum": 0,
          "title": "Valid Until Epoch",
          "type": "integer"
        }
      },
      "required": [
        "candidate_digest",
        "base_digest",
        "evidence_digest",
        "path_manifest_digest",
        "issuer_id",
        "valid_from_epoch",
        "valid_until_epoch"
      ],
      "title": "PathManifestAttestation",
      "type": "object"
    },
    "PromotionBundle": {
      "additionalProperties": false,
      "properties": {
        "comparison": {
          "$ref": "#/$defs/WorkspaceComparison"
        },
        "controller_config": {
          "$ref": "#/$defs/PromotionControllerConfig"
        },
        "controller_config_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Controller Config Digest",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/PromotionDecision"
        },
        "decision_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Decision Digest",
          "type": "string"
        },
        "evidence_digests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Digests",
          "type": "array"
        },
        "format": {
          "const": "avo-promotion-bundle-v1",
          "default": "avo-promotion-bundle-v1",
          "title": "Format",
          "type": "string"
        },
        "operation_kind": {
          "anyOf": [
            {
              "enum": [
                "ordinary_campaign",
                "authorized_rollback"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operation Kind"
        },
        "provenance": {
          "$ref": "#/$defs/PromotionProvenanceBinding"
        },
        "request": {
          "$ref": "#/$defs/PromotionRequest"
        },
        "request_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Digest",
          "type": "string"
        },
        "rollback_authorization": {
          "anyOf": [
            {
              "$ref": "#/$defs/RollbackPromotionBundleAuthorization"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rollback_operation_id": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rollback Operation Id"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "snapshot": {
          "$ref": "#/$defs/GitRefSnapshot"
        }
      },
      "required": [
        "snapshot",
        "comparison",
        "request",
        "request_digest",
        "controller_config",
        "controller_config_digest",
        "decision",
        "decision_digest",
        "provenance",
        "evidence_digests"
      ],
      "title": "PromotionBundle",
      "type": "object"
    },
    "PromotionConfig": {
      "additionalProperties": false,
      "properties": {
        "candidate_proposers": {
          "minProperties": 1,
          "patternProperties": {
            "^sha256:[0-9a-f]{64}$": {
              "minLength": 1,
              "type": "string"
            }
          },
          "title": "Candidate Proposers",
          "type": "object"
        },
        "evaluation_epoch": {
          "minimum": 0,
          "title": "Evaluation Epoch",
          "type": "integer"
        },
        "low_gates": {
          "default": [
            "deterministic",
            "provenance"
          ],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Low Gates",
          "type": "array",
          "uniqueItems": true
        },
        "ordinary_gates": {
          "default": [
            "integration_soak",
            "private_evaluation",
            "provenance",
            "trusted_ci"
          ],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Ordinary Gates",
          "type": "array",
          "uniqueItems": true
        },
        "proposer_domains": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "title": "Proposer Domains",
          "type": "object"
        },
        "reviewer_domains": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "title": "Reviewer Domains",
          "type": "object"
        },
        "rollback_issuer_ids": {
