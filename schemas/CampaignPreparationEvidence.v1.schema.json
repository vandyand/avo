{
  "$defs": {
    "IntegrationIntentTemplate": {
      "additionalProperties": false,
      "description": "Lease-independent promotion identity awaiting a fresh controller lease.",
      "properties": {
        "base_commit": {
          "title": "Base Commit",
          "type": "string"
        },
        "base_tree": {
          "title": "Base Tree",
          "type": "string"
        },
        "bundle_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Bundle Digest",
          "type": "string"
        },
        "candidate_commit": {
          "title": "Candidate Commit",
          "type": "string"
        },
        "candidate_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Digest",
          "type": "string"
        },
        "candidate_head_commit": {
          "title": "Candidate Head Commit",
          "type": "string"
        },
        "candidate_head_ref": {
          "minLength": 1,
          "title": "Candidate Head Ref",
          "type": "string"
        },
        "candidate_head_tree": {
          "title": "Candidate Head Tree",
          "type": "string"
        },
        "candidate_ref": {
          "minLength": 1,
          "title": "Candidate Ref",
          "type": "string"
        },
        "candidate_repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Repository Digest",
          "type": "string"
        },
        "candidate_tree": {
          "title": "Candidate Tree",
          "type": "string"
        },
        "check_evidence_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Check Evidence Manifest Digest",
          "type": "string"
        },
        "controller_config_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Controller Config Digest",
          "type": "string"
        },
        "evidence_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Evidence Manifest Digest",
          "type": "string"
        },
        "expected_main_commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Main Commit"
        },
        "merge_method": {
          "const": "squash",
          "title": "Merge Method",
          "type": "string"
        },
        "operation_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Operation Id",
          "type": "string"
        },
        "protection_evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Protection Evidence Digest",
          "type": "string"
        },
        "provider_api_version": {
          "minLength": 1,
          "title": "Provider Api Version",
          "type": "string"
        },
        "provider_identity": {
          "minLength": 1,
          "title": "Provider Identity",
          "type": "string"
        },
        "publication_evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Publication Evidence Digest",
          "type": "string"
        },
        "pull_request_number": {
          "exclusiveMinimum": 0,
          "title": "Pull Request Number",
          "type": "integer"
        },
        "pull_request_url": {
          "minLength": 1,
          "title": "Pull Request Url",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "synthetic_merge_commit": {
          "title": "Synthetic Merge Commit",
          "type": "string"
        },
        "synthetic_merge_tree": {
          "title": "Synthetic Merge Tree",
          "type": "string"
        },
        "target_base_commit": {
          "title": "Target Base Commit",
          "type": "string"
        },
        "target_base_ref": {
          "minLength": 1,
          "title": "Target Base Ref",
          "type": "string"
        },
        "target_base_tree": {
          "title": "Target Base Tree",
          "type": "string"
        },
        "target_ref": {
          "minLength": 1,
          "title": "Target Ref",
          "type": "string"
        },
        "target_repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Repository Digest",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "repository_digest",
        "candidate_ref",
        "target_ref",
        "base_commit",
        "base_tree",
        "candidate_commit",
        "candidate_tree",
        "candidate_repository_digest",
        "candidate_head_ref",
        "candidate_head_commit",
        "candidate_head_tree",
        "target_repository_digest",
        "target_base_ref",
        "target_base_commit",
        "target_base_tree",
        "synthetic_merge_commit",
        "synthetic_merge_tree",
        "bundle_digest",
        "candidate_digest",
        "controller_config_digest",
        "protection_evidence_digest",
        "evidence_manifest_digest",
        "check_evidence_manifest_digest",
        "publication_evidence_digest",
        "pull_request_number",
        "pull_request_url",
        "provider_identity",
        "provider_api_version",
        "merge_method"
      ],
      "title": "IntegrationIntentTemplate",
      "type": "object"
    },
    "IntegrationProviderObservation": {
      "additionalProperties": false,
      "description": "Provider-side PR observation used before requesting a merge.",
      "properties": {
        "base_commit": {
          "title": "Base Commit",
          "type": "string"
        },
        "base_ref": {
          "minLength": 1,
          "title": "Base Ref",
          "type": "string"
        },
        "base_tree": {
          "title": "Base Tree",
          "type": "string"
        },
        "candidate_repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Repository Digest",
          "type": "string"
        },
        "candidate_tree": {
          "title": "Candidate Tree",
          "type": "string"
        },
        "check_evidence_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Check Evidence Manifest Digest",
          "type": "string"
        },
        "draft": {
          "const": false,
          "default": false,
          "title": "Draft",
          "type": "boolean"
        },
        "head_commit": {
          "title": "Head Commit",
          "type": "string"
        },
        "head_ref": {
          "minLength": 1,
          "title": "Head Ref",
          "type": "string"
        },
        "open_state": {
          "const": "open",
          "title": "Open State",
          "type": "string"
        },
        "protection_evidence_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Protection Evidence Digest",
          "type": "string"
        },
        "provider_api_version": {
          "minLength": 1,
          "title": "Provider Api Version",
          "type": "string"
        },
        "provider_identity": {
          "minLength": 1,
          "title": "Provider Identity",
          "type": "string"
        },
        "pull_request_number": {
          "exclusiveMinimum": 0,
          "title": "Pull Request Number",
          "type": "integer"
        },
        "pull_request_url": {
          "minLength": 1,
          "title": "Pull Request Url",
          "type": "string"
        },
        "repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Repository Digest",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "synthetic_merge_commit": {
          "title": "Synthetic Merge Commit",
          "type": "string"
        },
        "synthetic_merge_tree": {
          "title": "Synthetic Merge Tree",
          "type": "string"
        },
        "target_repository_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Repository Digest",
          "type": "string"
        }
      },
      "required": [
        "repository_digest",
        "pull_request_number",
        "pull_request_url",
        "candidate_repository_digest",
        "target_repository_digest",
        "base_ref",
        "base_commit",
        "base_tree",
        "head_ref",
        "head_commit",
        "candidate_tree",
        "synthetic_merge_commit",
        "synthetic_merge_tree",
        "protection_evidence_digest",
        "check_evidence_manifest_digest",
        "provider_identity",
        "provider_api_version",
        "open_state"
      ],
      "title": "IntegrationProviderObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Durable marker/template binding immediately before promotion.",
  "properties": {
    "marker_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Marker Digest"
    },
    "marker_verified": {
      "title": "Marker Verified",
      "type": "boolean"
    },
    "observation": {
      "$ref": "#/$defs/IntegrationProviderObservation"
    },
    "open_identity": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Open Identity",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "template": {
      "$ref": "#/$defs/IntegrationIntentTemplate"
    }
  },
  "required": [
    "template",
    "observation",
    "marker_verified",
    "open_identity"
  ],
  "title": "CampaignPreparationEvidence",
  "type": "object"
}
