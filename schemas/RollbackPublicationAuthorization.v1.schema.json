{
  "additionalProperties": false,
  "description": "Durable, content-addressed authority created before candidate push.",
  "properties": {
    "authority_config_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authority Config Digest",
      "type": "string"
    },
    "authorization_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authorization Id",
      "type": "string"
    },
    "authorized": {
      "const": true,
      "default": true,
      "title": "Authorized",
      "type": "boolean"
    },
    "canary_operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Canary Operation Id",
      "type": "string"
    },
    "canary_package_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Canary Package Digest",
      "type": "string"
    },
    "candidate_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Digest",
      "type": "string"
    },
    "candidate_ref": {
      "minLength": 1,
      "title": "Candidate Ref",
      "type": "string"
    },
    "changed_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Changed Paths",
      "type": "array"
    },
    "controller_identity": {
      "minLength": 1,
      "title": "Controller Identity",
      "type": "string"
    },
    "failed_integration_head_commit": {
      "title": "Failed Integration Head Commit",
      "type": "string"
    },
    "failed_integration_head_tree": {
      "title": "Failed Integration Head Tree",
      "type": "string"
    },
    "failed_soak_attestation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Failed Soak Attestation Digest",
      "type": "string"
    },
    "failed_soak_attestation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Failed Soak Attestation Id",
      "type": "string"
    },
    "issuer_id": {
      "minLength": 1,
      "title": "Issuer Id",
      "type": "string"
    },
    "main_before_commit": {
      "title": "Main Before Commit",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "publication_evidence_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Publication Evidence Digest",
      "type": "string"
    },
    "publication_plan_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Publication Plan Digest",
      "type": "string"
    },
    "publisher_identity": {
      "minLength": 1,
      "title": "Publisher Identity",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "restore_to_commit": {
      "title": "Restore To Commit",
      "type": "string"
    },
    "restore_to_tree": {
      "title": "Restore To Tree",
      "type": "string"
    },
    "rollback_candidate_commit": {
      "title": "Rollback Candidate Commit",
      "type": "string"
    },
    "rollback_candidate_parent_commit": {
      "title": "Rollback Candidate Parent Commit",
      "type": "string"
    },
    "rollback_candidate_tree": {
      "title": "Rollback Candidate Tree",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_ref": {
      "const": "refs/heads/integration",
      "default": "refs/heads/integration",
      "title": "Target Ref",
      "type": "string"
    }
  },
  "required": [
    "operation_id",
    "canary_operation_id",
    "canary_package_digest",
    "repository_digest",
    "main_before_commit",
    "failed_integration_head_commit",
    "failed_integration_head_tree",
    "restore_to_commit",
    "restore_to_tree",
    "rollback_candidate_commit",
    "rollback_candidate_tree",
    "rollback_candidate_parent_commit",
    "candidate_digest",
    "candidate_ref",
    "changed_paths",
    "publication_plan_digest",
    "publication_evidence_digest",
    "failed_soak_attestation_id",
    "failed_soak_attestation_digest",
    "authority_config_digest",
    "controller_identity",
    "publisher_identity",
    "issuer_id",
    "reason",
    "authorization_id"
  ],
  "title": "RollbackPublicationAuthorization",
  "type": "object"
}
