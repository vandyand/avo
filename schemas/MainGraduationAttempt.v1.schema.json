{
  "additionalProperties": false,
  "properties": {
    "deploy_performed": {
      "const": false,
      "default": false,
      "title": "Deploy Performed",
      "type": "boolean"
    },
    "disposition_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Disposition Digest"
    },
    "eligibility_record_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Eligibility Record Digest",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "package_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Package Digest"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "scheduler_sequence": {
      "exclusiveMinimum": 0,
      "title": "Scheduler Sequence",
      "type": "integer"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    },
    "terminal_disposition": {
      "anyOf": [
        {
          "enum": [
            "success",
            "failed",
            "quarantined",
            "reconciliation_required",
            "reset"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Terminal Disposition"
    }
  },
  "required": [
    "repository_digest",
    "operation_id",
    "scheduler_sequence",
    "eligibility_record_digest"
  ],
  "title": "MainGraduationAttempt",
  "type": "object"
}
