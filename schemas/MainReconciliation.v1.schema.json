{
  "additionalProperties": false,
  "properties": {
    "claimed_transition_receipt_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Claimed Transition Receipt Digest"
    },
    "deploy_performed": {
      "const": false,
      "default": false,
      "title": "Deploy Performed",
      "type": "boolean"
    },
    "expected_base_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Expected Base Commit",
      "type": "string"
    },
    "expected_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Expected Tree",
      "type": "string"
    },
    "main_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Main Commit",
      "type": "string"
    },
    "main_parents": {
      "items": {
        "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
        "type": "string"
      },
      "title": "Main Parents",
      "type": "array"
    },
    "main_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Main Tree",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "queue_generation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Queue Generation Digest",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "enum": [
        "pending",
        "completed",
        "failed",
        "reconciliation_required"
      ],
      "title": "State",
      "type": "string"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    },
    "transition_receipt_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transition Receipt Digest"
    }
  },
  "required": [
    "repository_digest",
    "operation_id",
    "state",
    "main_commit",
    "main_tree",
    "main_parents",
    "expected_tree",
    "expected_base_commit",
    "queue_generation_digest"
  ],
  "title": "MainReconciliation",
  "type": "object"
}
