{
  "additionalProperties": false,
  "description": "An immutable catalog entry that a review may cite.",
  "properties": {
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "evidence_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Evidence Id",
      "type": "string"
    },
    "label": {
      "default": "",
      "maxLength": 512,
      "title": "Label",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "evidence_id",
    "content_digest"
  ],
  "title": "AdvisoryEvidenceItem",
  "type": "object"
}
