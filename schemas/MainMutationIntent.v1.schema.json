            "pull_request_open",
            "admission_check",
            "queue_enqueue",
            "merge_group_hold",
            "release_transition"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Stage"
    },
    "policy_epoch_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Epoch Digest",
      "type": "string"
    },
    "preparation_authorization_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Preparation Authorization Digest",
      "type": "string"
    },
    "recorded_at": {
      "format": "date-time",
      "title": "Recorded At",
      "type": "string"
    },
    "release_authorization_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Authorization Digest"
    },
    "release_claim_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Claim Digest"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "stage": {
      "enum": [
        "candidate_publication",
        "pull_request_open",
        "admission_check",
        "queue_enqueue",
        "merge_group_hold",
        "release_transition"
      ],
      "title": "Stage",
      "type": "string"
    },
    "state": {
      "const": "intent_recorded",
      "default": "intent_recorded",
      "title": "State",
      "type": "string"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    }
  },
  "required": [
    "repository_digest",
    "operation_id",
    "stage",
    "lease_identity",
    "lease_digest",
    "lease_epoch_digest",
    "policy_epoch_digest",
    "controller_config_digest",
    "preparation_authorization_digest",
    "external_identity",
    "request_digest",
    "recorded_at",
    "intent_digest"
  ],
  "title": "MainMutationIntent",
  "type": "object"
}
