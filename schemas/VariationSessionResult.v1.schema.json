{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "role": {
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "digest",
        "size_bytes",
        "media_type",
        "role",
        "created_at"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "UsageRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact_bytes": {
          "minimum": 0,
          "title": "Artifact Bytes",
          "type": "integer"
        },
        "authoritative_evaluations": {
          "minimum": 0,
          "title": "Authoritative Evaluations",
          "type": "integer"
        },
        "model_cost_microusd": {
          "minimum": 0,
          "title": "Model Cost Microusd",
          "type": "integer"
        },
        "model_input_tokens": {
          "minimum": 0,
          "title": "Model Input Tokens",
          "type": "integer"
        },
        "model_output_tokens": {
          "minimum": 0,
          "title": "Model Output Tokens",
          "type": "integer"
        },
        "sandbox_cpu_seconds": {
          "minimum": 0,
          "title": "Sandbox Cpu Seconds",
          "type": "integer"
        },
        "sandbox_gpu_seconds": {
          "minimum": 0,
          "title": "Sandbox Gpu Seconds",
          "type": "integer"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "tool_calls": {
          "minimum": 0,
          "title": "Tool Calls",
          "type": "integer"
        },
        "variation_sessions": {
          "minimum": 0,
          "title": "Variation Sessions",
          "type": "integer"
        },
        "wall_clock_seconds": {
          "minimum": 0,
          "title": "Wall Clock Seconds",
          "type": "integer"
        }
      },
      "required": [
        "wall_clock_seconds",
        "model_input_tokens",
        "model_output_tokens",
        "model_cost_microusd",
        "tool_calls",
        "sandbox_cpu_seconds",
        "sandbox_gpu_seconds",
        "authoritative_evaluations",
        "variation_sessions",
        "artifact_bytes"
      ],
      "title": "UsageRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "attempt_index_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Attempt Index Digest",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "proposal_ready",
        "exhausted",
        "policy_blocked",
        "cancelled",
        "failed"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "proposed_patch_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposed Patch Digest"
    },
    "proposed_workspace_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Proposed Workspace Digest"
    },
    "rationale_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "usage": {
      "$ref": "#/$defs/UsageRecord"
    }
  },
  "required": [
    "session_id",
    "outcome",
    "attempt_index_digest",
    "usage"
  ],
  "title": "VariationSessionResult",
  "type": "object"
}
