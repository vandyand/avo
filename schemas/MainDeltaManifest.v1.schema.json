{
  "additionalProperties": false,
  "description": "The exact sole-parent-to-result delta selected from the source package.",
  "properties": {
    "changed_paths": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Changed Paths",
      "type": "array"
    },
    "delta_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Delta Digest",
      "type": "string"
    },
    "deploy_performed": {
      "const": false,
      "default": false,
      "title": "Deploy Performed",
      "type": "boolean"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "ordinary_risk": {
      "const": "ordinary",
      "default": "ordinary",
      "title": "Ordinary Risk",
      "type": "string"
    },
    "ordinary_risk_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Ordinary Risk Digest",
      "type": "string"
    },
    "package_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Package Digest",
      "type": "string"
    },
    "path_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Path Manifest Digest",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_result_commit": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Source Result Commit",
      "type": "string"
    },
    "source_result_parent": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Source Result Parent",
      "type": "string"
    },
    "source_result_tree": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "title": "Source Result Tree",
      "type": "string"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    }
  },
  "required": [
    "repository_digest",
    "operation_id",
    "package_digest",
    "source_result_commit",
    "source_result_parent",
    "source_result_tree",
    "changed_paths",
    "path_manifest_digest",
    "delta_digest",
    "ordinary_risk_digest"
  ],
  "title": "MainDeltaManifest",
  "type": "object"
}
