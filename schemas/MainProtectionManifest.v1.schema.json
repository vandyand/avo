{
  "additionalProperties": false,
  "properties": {
    "bypass_allowed": {
      "const": false,
      "default": false,
      "title": "Bypass Allowed",
      "type": "boolean"
    },
    "direct_merge_allowed": {
      "const": false,
      "default": false,
      "title": "Direct Merge Allowed",
      "type": "boolean"
    },
    "isolated_release_issuer": {
      "minLength": 1,
      "title": "Isolated Release Issuer",
      "type": "string"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "max_entries_per_group": {
      "const": 1,
      "default": 1,
      "title": "Max Entries Per Group",
      "type": "integer"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "operation_id": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Operation Id",
      "type": "string"
    },
    "protection_epoch": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Protection Epoch",
      "type": "string"
    },
    "provider_api_version": {
      "minLength": 1,
      "title": "Provider Api Version",
      "type": "string"
    },
    "provider_identity": {
      "minLength": 1,
      "title": "Provider Identity",
      "type": "string"
    },
    "queue_required": {
      "const": true,
      "default": true,
      "title": "Queue Required",
      "type": "boolean"
    },
    "release_context": {
      "const": "avo-main-release",
      "default": "avo-main-release",
      "title": "Release Context",
      "type": "string"
    },
    "repository_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Repository Digest",
      "type": "string"
    },
    "required": {
      "const": true,
      "default": true,
      "title": "Required",
      "type": "boolean"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "target_ref": {
      "const": "refs/heads/main",
      "default": "refs/heads/main",
      "title": "Target Ref",
      "type": "string"
    },
    "validation_app_id": {
      "const": 15368,
      "default": 15368,
      "title": "Validation App Id",
      "type": "integer"
    }
  },
  "required": [
    "repository_digest",
    "operation_id",
    "manifest_digest",
    "provider_identity",
    "provider_api_version",
    "isolated_release_issuer",
    "protection_epoch",
    "observed_at"
  ],
  "title": "MainProtectionManifest",
  "type": "object"
}
